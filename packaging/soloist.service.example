[Unit]
Description=Spotify Soloist playback
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
Type=simple
EnvironmentFile=%h/.config/soloist/env
ExecStart=%h/.local/bin/soloist --device-name ${SOLOIST_NAME} --api-key ${SOLOIST_API_KEY} --ws 127.0.0.1:9090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
